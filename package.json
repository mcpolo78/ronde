{
  "name": "ronde",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "turbo run codegen",
    "db:dev": "pnpm --filter @ronde/api db:dev",
    "db:push": "pnpm --filter @ronde/api db:push",
    "db:seed": "pnpm --filter @ronde/api db:seed",
    "db:deploy": "pnpm --filter @ronde/api db:deploy"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "~6.0.3"
  }
}
