{
  "name": "@ronde/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "codegen": "prisma generate && tsx scripts/print-schema.ts",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "db:dev": "prisma dev --name ronde --detach",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-prisma": "^4.17.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@ronde/domain": "workspace:*",
    "better-auth": "1.7.7",
    "graphql": "^16.14.2",
    "graphql-scalars": "^1.24.2",
    "graphql-yoga": "^5.24.5",
    "pg": "^8.16.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@ronde/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.3",
    "prisma": "7.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
