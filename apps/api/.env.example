# Base locale : `pnpm db:dev` démarre PostgreSQL 17 (paquet embedded-postgres, sans Docker)
# sur le port 5433, données dans apps/api/.pgdata.
DATABASE_URL="postgres://postgres:postgres@localhost:5433/ronde"
PORT=4000

# Origines autorisées (CORS + protection CSRF de Better Auth), séparées par des virgules
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Authentification
# URL publique du back-office : le navigateur appelle /api/auth/* sur ce domaine
BETTER_AUTH_URL="http://localhost:3000"
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Dev uniquement : l'en-tête `x-dev-user: <email>` remplace la session (GraphiQL, tests)
ALLOW_DEV_IMPERSONATION=true
