# Base locale : `pnpm db:dev` démarre une Postgres locale (Prisma Postgres, sans Docker)
# et affiche l'URL à coller ici.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
PORT=4000

# Origines autorisées (CORS + protection CSRF de Better Auth), séparées par des virgules
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Authentification
# URL publique du back-office : le navigateur appelle /api/auth/* sur ce domaine
BETTER_AUTH_URL="http://localhost:3000"
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Dev uniquement : l'en-tête `x-dev-user: <email>` remplace la session (GraphiQL, tests)
ALLOW_DEV_IMPERSONATION=true
