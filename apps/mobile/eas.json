{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.15.0",
      "pnpm": "12.11.2",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ronde-api-nc26.onrender.com"
      }
    },
    "development": {
      "node": "24.15.0",
      "pnpm": "12.11.2",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
